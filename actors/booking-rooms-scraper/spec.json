  "storeCopy": {
    "seoTitle": "Booking.com Rooms | Room Rates",
    "seoDescription": "Scrape Booking.com room options by hotel URL and travel dates. Export room names, prices, occupancy, bed details, and availability for stay comparison.",
    "intro": "Check Booking.com room options for hotel URLs with room names, prices, occupancy, bed descriptions, and availability. Omitted dates default to a future two-night stay.",
    "useCases": [
      "Travel planners can compare available room types before choosing a hotel.",
      "Hospitality analysts can monitor quoted room prices for selected travel dates.",
      "Booking teams can collect occupancy and bed details for lodging research."
    ],
    "howToUse": [
      "Add one Booking.com hotel URL per entry in `hotels`.",
      "Set check-in and check-out dates or use the relative date defaults.",
      "Choose guest counts and currency, then export the room rows."
    ],
    "faqs": [
      {
        "question": "Are room prices guaranteed?",
        "answer": "No. Prices and availability can change before booking and depend on the selected dates, guest count, and source response."
      }
