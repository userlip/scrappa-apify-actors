{
  "actorSpecification": 1,
  "minMemoryMbytes": 128,
  "maxMemoryMbytes": 128,
  "name": "linkedin-jobs-search-scraper",
  "title": "LinkedIn Jobs Search Scraper",
  "description": "Find LinkedIn job search results by role or location. Get each result title, link and snippet from Google Search, then use the supported query and pagination inputs to collect more results.",
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": {
    "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY"
  },
  "resources": {
    "memoryMbytes": 128
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "jobs": {
          "title": "LinkedIn Job Results",
          "transformation": {
            "fields": ["position", "title", "link", "displayed_link", "snippet"]
          },
          "display": {
            "component": "table",
            "properties": {
              "position": { "label": "Position", "format": "number" },
              "title": { "label": "Title", "format": "text" },
              "link": { "label": "LinkedIn URL", "format": "link" },
              "displayed_link": { "label": "Displayed Link", "format": "text" },
              "snippet": { "label": "Snippet", "format": "text" }
            }
          }
        }
      }
    }
  }
}
