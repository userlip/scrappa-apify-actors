{
  "actorSpecification": 1,
  "name": "vinted-user-items-scraper",
  "title": "Vinted User Items Scraper",
  "description": "Fetch listed items from one or more Vinted seller user IDs for inventory monitoring, reseller research, and competitor tracking.",
  "version": "1.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "ts-start"
  },
  "input": "./input_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": {
    "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY"
  },
  "resources": {
    "memoryMbytes": 256
  },
  "defaultRunOptions": {
    "timeoutSecs": 420
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "items": {
          "title": "Vinted Seller Listings",
          "transformation": {
            "fields": ["id", "title", "price_amount", "price_currency", "total_item_price", "total_item_price_currency", "shipping_price", "shipping_price_currency", "brand_name", "category_name", "size_name", "condition", "url", "image_url", "seller_id", "seller_login", "favourite_count", "view_count", "input_user_id", "request_country", "request_page", "request_per_page", "request_order", "total_entries", "total_pages"]
          },
          "display": {
            "component": "table",
            "properties": {
              "id": { "label": "Item ID", "format": "text" },
              "title": { "label": "Title", "format": "text" },
              "price_amount": { "label": "Price", "format": "text" },
              "price_currency": { "label": "Currency", "format": "text" },
              "total_item_price": { "label": "Total Price", "format": "text" },
              "total_item_price_currency": { "label": "Total Currency", "format": "text" },
              "shipping_price": { "label": "Shipping", "format": "text" },
              "shipping_price_currency": { "label": "Shipping Currency", "format": "text" },
              "brand_name": { "label": "Brand", "format": "text" },
              "category_name": { "label": "Category", "format": "text" },
              "size_name": { "label": "Size", "format": "text" },
              "condition": { "label": "Condition", "format": "text" },
              "url": { "label": "Listing URL", "format": "link" },
              "image_url": { "label": "Image", "format": "image" },
              "seller_id": { "label": "Seller ID", "format": "text" },
              "seller_login": { "label": "Seller", "format": "text" },
              "favourite_count": { "label": "Favorites", "format": "number" },
              "view_count": { "label": "Views", "format": "number" },
              "input_user_id": { "label": "Input User ID", "format": "text" },
              "request_country": { "label": "Country", "format": "text" },
              "request_page": { "label": "Page", "format": "number" },
              "request_per_page": { "label": "Per Page", "format": "number" },
              "request_order": { "label": "Sort", "format": "text" },
              "total_entries": { "label": "Total Listings", "format": "number" },
              "total_pages": { "label": "Total Pages", "format": "number" }
            }
          }
        }
      }
    }
  }
}
