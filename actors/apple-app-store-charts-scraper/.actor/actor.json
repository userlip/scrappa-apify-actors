{
  "actorSpecification": 1,
  "name": "apple-app-store-charts-scraper",
  "title": "Apple App Store Top Charts Scraper",
  "description": "Get Apple App Store chart rankings with position, app title, developer, product ID, genre, and listing URL. Batch chart types or storefronts to compare app visibility.",
  "categories": [
    "ECOMMERCE",
    "MARKETING"
  ],
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": {
    "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY"
  },
  "defaultMemoryMbytes": 128,
  "defaultRunOptions": {
    "timeoutSecs": 300
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "results": {
          "title": "Results",
          "transformation": {
            "fields": [
              "position",
              "title",
              "artist",
              "id",
              "url"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "position": {
                "label": "Rank",
                "format": "number"
              },
              "title": {
                "label": "App",
                "format": "text"
              },
              "artist": {
                "label": "Developer",
                "format": "text"
              },
              "id": {
                "label": "Product ID",
                "format": "text"
              },
              "url": {
                "label": "App Store URL",
                "format": "link"
              }
            }
          }
        }
      }
    }
  }
}
