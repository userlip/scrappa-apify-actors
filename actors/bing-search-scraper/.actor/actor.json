{
  "actorSpecification": 1,
  "minMemoryMbytes": 128,
  "maxMemoryMbytes": 128,
  "name": "bing-search-scraper",
  "title": "Bing Search Scraper",
  "description": "Search Bing for ranked titles, page snippets, domains, and links. Batch multiple keywords in one run to monitor rankings, compare competitors, or gather source pages.",
  "categories": [
    "SEO_TOOLS"
  ],
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": {
    "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY"
  },
  "defaultMemoryMbytes": 128,
  "defaultRunOptions": {
    "timeoutSecs": 300
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "results": {
          "title": "Results",
          "transformation": {
            "fields": [
              "title",
              "description",
              "url",
              "domain",
              "position"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "title": {
                "label": "Title",
                "format": "text"
              },
              "description": {
                "label": "Description",
                "format": "text"
              },
              "url": {
                "label": "URL",
                "format": "link"
              },
              "domain": {
                "label": "Domain",
                "format": "text"
              },
              "position": {
                "label": "Position",
                "format": "number"
              }
            }
          }
        }
      }
    }
  }
}
