{
  "actorSpecification": 1,
  "name": "bing-search-scraper",
  "title": "Bing Search Scraper",
  "description": "Bing Search Scraper collects structured data from Scrappa's /bing/search endpoint. Submit multiple inputs in one Actor run and receive one dataset item per result.",
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": {
    "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY"
  },
  "defaultMemoryMbytes": 128,
  "defaultRunOptions": {
    "timeoutSecs": 300
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "results": {
          "title": "Results",
          "transformation": {
            "fields": [
              "title",
              "description",
              "url",
              "domain",
              "position"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "title": {
                "label": "Title",
                "format": "text"
              },
              "description": {
                "label": "Description",
                "format": "text"
              },
              "url": {
                "label": "Url",
                "format": "link"
              },
              "domain": {
                "label": "Domain",
                "format": "text"
              },
              "position": {
                "label": "Position",
                "format": "number"
              }
            }
          }
        }
      }
    }
  }
}
