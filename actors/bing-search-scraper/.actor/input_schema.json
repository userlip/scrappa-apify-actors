{
  "title": "Bing Search Scraper",
  "description": "Search Bing for ranked titles, page snippets, domains, and links. Batch multiple keywords in one run to monitor rankings, compare competitors, or gather source pages.",
  "type": "object",
  "schemaVersion": 1,
  "required": [
    "queries"
  ],
  "properties": {
    "queries": {
      "title": "Search queries",
      "type": "array",
      "description": "Bing search phrases. Add one object per phrase.",
      "editor": "json",
      "minItems": 1,
      "maxItems": 100,
      "prefill": [
        {
          "query": "python tutorial"
        }
      ],
      "items": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "title": "Search query",
            "type": "string",
            "description": "Search query (max 500 characters).",
            "maxLength": 500,
            "editor": "textfield"
          },
          "page": {
            "title": "Page",
            "type": "integer",
            "description": "Page number (1-50).",
            "minimum": 1,
            "maximum": 50,
            "default": 1,
            "editor": "number"
          },
          "num": {
            "title": "Results per page",
            "type": "integer",
            "description": "Results per page (1-50).",
            "minimum": 1,
            "maximum": 50,
            "default": 10,
            "editor": "number"
          },
          "site": {
            "title": "Site",
            "type": "string",
            "description": "Restrict results to this domain, e.g. example.com.",
            "maxLength": 253,
            "editor": "textfield"
          },
          "filetype": {
            "title": "Filetype",
            "type": "string",
            "description": "Restrict results to this file extension, e.g. pdf.",
            "maxLength": 20,
            "pattern": "^[a-zA-Z0-9]+$",
            "editor": "textfield"
          },
          "safe": {
            "title": "Safe",
            "type": "string",
            "description": "SafeSearch level: off, moderate or strict.",
            "enum": [
              "off",
              "moderate",
              "strict"
            ],
            "default": "moderate",
            "editor": "select"
          },
          "hl": {
            "title": "Language",
            "type": "string",
            "description": "Language code, e.g. en or en-GB.",
            "maxLength": 20,
            "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z]{2})?$",
            "editor": "textfield"
          },
          "include_html": {
            "title": "Include raw HTML",
            "type": "boolean",
            "description": "Set to true to include the raw HTML in the response. Default: false.",
            "editor": "checkbox"
          }
        }
      }
    },
    "page": {
      "title": "Page",
      "type": "integer",
      "description": "Page number (1-50).",
      "minimum": 1,
      "maximum": 50,
      "default": 1,
      "editor": "number"
    },
    "num": {
      "title": "Results per page",
      "type": "integer",
      "description": "Results per page (1-50).",
      "minimum": 1,
      "maximum": 50,
      "default": 10,
      "editor": "number"
    },
    "site": {
      "title": "Site",
      "type": "string",
      "description": "Restrict results to this domain, e.g. example.com.",
      "maxLength": 253,
      "editor": "textfield"
    },
    "filetype": {
      "title": "Filetype",
      "type": "string",
      "description": "Restrict results to this file extension, e.g. pdf.",
      "maxLength": 20,
      "pattern": "^[a-zA-Z0-9]+$",
      "editor": "textfield"
    },
    "safe": {
      "title": "Safe",
      "type": "string",
      "description": "SafeSearch level: off, moderate or strict.",
      "enum": [
        "off",
        "moderate",
        "strict"
      ],
      "default": "moderate",
      "editor": "select"
    },
    "hl": {
      "title": "Language",
      "type": "string",
      "description": "Language code, e.g. en or en-GB.",
      "maxLength": 20,
      "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z]{2})?$",
      "editor": "textfield"
    },
    "include_html": {
      "title": "Include raw HTML",
      "type": "boolean",
      "description": "Set to true to include the raw HTML in the response. Default: false.",
      "editor": "checkbox"
    },
    "maxResults": {
      "title": "Maximum Results",
      "type": "integer",
      "description": "Maximum dataset items to save across this entire run.",
      "editor": "number",
      "minimum": 1,
      "maximum": 1000,
      "default": 100
    }
  }
}
