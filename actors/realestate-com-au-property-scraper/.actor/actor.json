{
  "actorSpecification": 1,
  "minMemoryMbytes": 128,
  "maxMemoryMbytes": 128,
  "name": "realestate-com-au-property-scraper",
  "title": "Realestate.com.au Property Details Scraper",
  "description": "Retrieve realestate.com.au property details with price, address, bedrooms, bathrooms, parking, media, agency, and agent information. Batch listing URLs to review Australian homes.",
  "categories": [
    "REAL_ESTATE"
  ],
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": {
    "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY"
  },
  "defaultMemoryMbytes": 128,
  "defaultRunOptions": {
    "timeoutSecs": 300
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "results": {
          "title": "Results",
          "transformation": {
            "fields": [
              "listing_id",
              "price",
              "property_type",
              "suburb",
              "bedrooms",
              "bathrooms",
              "agency_name",
              "listing_url"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "listing_id": {
                "label": "Listing Id",
                "format": "text"
              },
              "price": {
                "label": "Price",
                "format": "number"
              },
              "property_type": {
                "label": "Property Type",
                "format": "text"
              },
              "suburb": {
                "label": "Suburb",
                "format": "text"
              },
              "bedrooms": {
                "label": "Bedrooms",
                "format": "number"
              },
              "bathrooms": {
                "label": "Bathrooms",
                "format": "number"
              },
              "agency_name": {
                "label": "Agency Name",
                "format": "text"
              },
              "listing_url": {
                "label": "Listing Url",
                "format": "link"
              }
            }
          }
        }
      }
    }
  }
}
