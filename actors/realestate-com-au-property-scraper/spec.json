    "field": "property_urls",
    "valueField": "url",
    "apiParam": "url",
    "pathParam": null,
    "title": "Property URLs",
    "description": "Full realestate.com.au listing URLs to retrieve.",
    "valueDescription": "property URL whose details are requested."
