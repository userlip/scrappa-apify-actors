{
  "actorSpecification": 1,
  "name": "google-finance-indices-scraper",
  "title": "Google Finance Indices Scraper",
  "description": "Compare Google Finance index quotes with tickers, index levels and daily changes. Supply supported index codes to compare their current levels and daily movement.",
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": { "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY" },
  "resources": { "memoryMbytes": 128 },
  "defaultRunOptions": { "timeoutSecs": 120 },
  "storages": { "dataset": { "actorSpecification": 1, "views": { "indices": { "title": "Indices", "transformation": { "fields": ["id", "requested_symbol", "symbol", "name", "exchange", "current_price", "price_change", "percent_change", "previous_close", "movement_direction", "request_hl", "request_gl", "retrieved_at"] } } } } }
}
