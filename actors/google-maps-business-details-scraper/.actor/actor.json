{
  "actorSpecification": 1,
  "name": "google-maps-business-details-scraper",
  "title": "Google Maps Business Details Scraper",
  "description": "Look up a Google Maps business profile with its address, rating, hours and website. Pass one or more place IDs to look up the matching Google Maps business profiles.",
  "version": "1.0",
  "buildTag": "latest",
  "icon": "🏢",
  "input": "./input_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": {
    "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY"
  },
  "resources": {
    "memoryMbytes": 128
  },
  "defaultRunOptions": {
    "timeoutSecs": 720
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Business Details",
          "transformation": {
            "fields": ["name", "rating", "review_count", "full_address", "phone_number", "website", "type"]
          },
          "display": {
            "component": "table",
            "properties": {
              "name": { "label": "Business Name", "format": "text" },
              "rating": { "label": "Rating", "format": "number" },
              "review_count": { "label": "Reviews", "format": "number" },
              "full_address": { "label": "Address", "format": "text" },
              "phone_number": { "label": "Phone", "format": "text" },
              "website": { "label": "Website", "format": "link" },
              "type": { "label": "Type", "format": "text" }
            }
          }
        }
      }
    }
  }
}
