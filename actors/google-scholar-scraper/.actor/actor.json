{
  "actorSpecification": 1,
  "name": "google-scholar-scraper",
  "title": "Google Scholar Scraper",
  "description": "Search Google Scholar for paper titles, authors, publication details, citations, and available resources. Batch research queries to build literature lists or monitor academic topics.",
  "categories": [
    "EDUCATION",
    "SEO_TOOLS"
  ],
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": {
    "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY"
  },
  "defaultMemoryMbytes": 128,
  "defaultRunOptions": {
    "timeoutSecs": 300
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "results": {
          "title": "Results",
          "transformation": {
            "fields": [
              "title",
              "link",
              "snippet",
              "publication_info",
              "result_id"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "title": {
                "label": "Title",
                "format": "text"
              },
              "link": {
                "label": "Link",
                "format": "link"
              },
              "snippet": {
                "label": "Snippet",
                "format": "text"
              },
              "publication_info": {
                "label": "Publication Info",
                "format": "text"
              },
              "result_id": {
                "label": "Result ID",
                "format": "text"
              }
            }
          }
        }
      }
    }
  }
}
