{
  "title": "YouTube Trending Videos",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "category": {
      "title": "Category",
      "type": "array",
      "description": "Optional category filter. Leave this empty to use YouTube’s default trending feed.",
      "editor": "select",
      "items": {
        "type": "string",
        "enum": [
          "education",
          "music",
          "gaming",
          "news",
          "sports",
          "entertainment",
          "howto",
          "tech",
          "science"
        ]
      }
    },
    "type": {
      "title": "Trending type",
      "type": "array",
      "description": "Trending period or mode.",
      "editor": "select",
      "items": {
        "type": "string",
        "enum": [
          "now"
        ]
      },
      "prefill": [
        "now"
      ]
    }
  }
}
