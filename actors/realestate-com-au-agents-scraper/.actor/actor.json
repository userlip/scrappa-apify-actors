{
  "actorSpecification": 1,
  "name": "realestate-com-au-agents-scraper",
  "title": "Realestate.com.au Agents Scraper",
  "description": "Find realestate.com.au agents by location with names, agencies, ratings, reviews, recent sales, and profile details. Batch Australian suburbs and page through results.",
  "categories": [
    "REAL_ESTATE",
    "LEAD_GENERATION"
  ],
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": {
    "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY"
  },
  "defaultMemoryMbytes": 128,
  "defaultRunOptions": {
    "timeoutSecs": 300
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "results": {
          "title": "Results",
          "transformation": {
            "fields": [
              "name",
              "agency",
              "rating",
              "reviews",
              "raw"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "name": {
                "label": "Name",
                "format": "text"
              },
              "agency": {
                "label": "Agency",
                "format": "text"
              },
              "rating": {
                "label": "Rating",
                "format": "number"
              },
              "reviews": {
                "label": "Reviews",
                "format": "text"
              },
              "raw": {
                "label": "Raw",
                "format": "text"
              }
            }
          }
        }
      }
    }
  }
}
