  "endpoint": "/realestate-com-au/agents",
  "openapiPath": "/realestate-com-au/agents",
  "mode": "list",
  "batch": {
    "field": "locations",
    "valueField": "location",
    "apiParam": "location",
    "pathParam": null,
    "title": "Agent search locations",
    "description": "Australian suburbs or localities to search for realestate.com.au agents.",
    "valueDescription": "location used to find realestate.com.au agents."
  },
  "parameters": [
    {
      "input": "url",
      "apiParam": "url",
      "location": "query",
      "required": false,
      "title": "URL",
      "schema": {
        "type": "string",
        "pattern": "^https:\\/\\/www\\.realestate\\.com\\.au\\/find-agent",
        "format": "uri",
        "description": "Full realestate.com.au find-agent URL."
      }
    },
    {
      "input": "location",
      "apiParam": "location",
      "location": "query",
      "required": true,
      "title": "Location",
      "schema": {
        "type": "string",
        "minLength": 2,
        "maxLength": 120,
        "pattern": "^[A-Za-z0-9,+ -]+$",
        "description": "Location slug or text such as sydney-nsw-2000. Required unless url is supplied."
      }
    },
    {
      "input": "page",
      "apiParam": "page",
      "location": "query",
      "required": false,
      "title": "Page",
      "schema": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "Page number for find-agent pagination."
      }
    }
  ],
  "maxResults": {
    "input": "maxResults",
    "default": 100,
    "hardLimit": 1000
  },
  "priceUsdPerResult": 0.0003,
  "timeoutSecs": 300,
  "prefill": {
    "locations": [
      {
        "location": "Richmond, VIC 3121"
      }
    ],
    "page": 1,
    "maxResults": 5,
    "maxPages": 1
