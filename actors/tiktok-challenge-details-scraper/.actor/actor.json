{
  "actorSpecification": 1,
  "name": "tiktok-challenge-details-scraper",
  "title": "TikTok Hashtag & Challenge Details Scraper",
  "description": "Collect hashtag and challenge video records from TikTok. Results can include `challenge_id`, `challenge_name`, `description`. Batch inputs can process multiple targets in one run. Save and export Apify datasets, schedule runs, or call the Actor through the API.",
  "version": "1.0", "buildTag": "latest",
  "input": "./input_schema.json", "dockerfile": "./Dockerfile",
  "environmentVariables": { "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY" },
  "resources": { "memoryMbytes": 128 },
  "defaultRunOptions": { "timeoutSecs": 120 },
  "storages": { "dataset": { "actorSpecification": 1, "views": {
    "challenge_details": {
      "title": "Challenge Details",
      "transformation": { "fields": ["challenge_id", "challenge_name", "description", "user_count", "view_count", "video_count", "cover", "request_challenge_name", "request_challenge_id", "retrieved_at"] },
      "display": { "component": "table", "properties": {
        "challenge_id": { "label": "Challenge ID", "format": "text" }, "challenge_name": { "label": "Challenge", "format": "text" },
        "description": { "label": "Description", "format": "text" }, "user_count": { "label": "Users", "format": "number" },
        "view_count": { "label": "Views", "format": "number" }, "video_count": { "label": "Videos", "format": "number" },
        "cover": { "label": "Cover", "format": "link" }, "request_challenge_name": { "label": "Requested name", "format": "text" },
        "request_challenge_id": { "label": "Requested ID", "format": "text" }, "retrieved_at": { "label": "Retrieved at", "format": "date" }
      }}
    }
  }}}
}
