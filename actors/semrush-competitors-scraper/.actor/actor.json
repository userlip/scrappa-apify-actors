{
  "actorSpecification": 1,
  "minMemoryMbytes": 128,
  "maxMemoryMbytes": 128,
  "name": "semrush-competitors-scraper",
  "title": "Semrush Competitors Scraper",
  "description": "Find organic competitors for a domain with Authority Score, estimated monthly visits, and Semrush Rank. Batch domains in one run to map competing sites or prioritize SEO analysis.",
  "categories": [
    "SEO_TOOLS",
    "MARKETING"
  ],
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": {
    "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY"
  },
  "defaultMemoryMbytes": 128,
  "defaultRunOptions": {
    "timeoutSecs": 300
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "results": {
          "title": "Results",
          "transformation": {
            "fields": [
              "domain",
              "authority_score",
              "visits",
              "semrush_rank"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "domain": {
                "label": "Domain",
                "format": "text"
              },
              "authority_score": {
                "label": "Authority Score",
                "format": "number"
              },
              "visits": {
                "label": "Visits",
                "format": "text"
              },
              "semrush_rank": {
                "label": "Semrush Rank",
                "format": "number"
              }
            }
          }
        }
      }
    }
  }
}
