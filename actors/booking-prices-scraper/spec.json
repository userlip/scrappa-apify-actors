{
  "slug": "booking-prices-scraper",
  "title": "Booking.com Hotel Prices Scraper",
  "description": "Compare Booking.com hotel prices by destination and stay dates, with property names, quoted prices, review scores, locations, and links. Search several cities in one run.",
  "endpoint": "/booking/prices",
  "openapiPath": "/booking/prices",
  "mode": "list",
  "batch": {
    "field": "destinations",
    "valueField": "ss",
    "apiParam": "ss",
    "pathParam": null,
    "title": "Destinations",
    "description": "Cities, regions, or destination names to search for Booking.com hotel prices.",
    "valueDescription": "Ss used to run this search."
  },
  "parameters": [
    {
      "input": "ss",
      "apiParam": "ss",
      "location": "query",
      "required": true,
      "title": "Ss",
      "schema": {
        "type": "string",
        "minLength": 2,
        "maxLength": 200,
        "description": "Destination, e.g. \"Paris\" or \"New York\"."
      },
      "editor": "textfield"
    },
    {
      "input": "checkin",
      "apiParam": "checkin",
      "location": "query",
      "required": false,
      "title": "Checkin",
      "schema": {
        "type": "string",
        "format": "date",
        "description": "Hotel check-in date in YYYY-MM-DD format."
      },
      "editor": "textfield"
    },
    {
      "input": "checkout",
      "apiParam": "checkout",
      "location": "query",
      "required": false,
      "title": "Checkout",
      "schema": {
        "type": "string",
        "format": "date",
        "description": "Hotel check-out date in YYYY-MM-DD format, after check-in."
      },
      "editor": "textfield"
    },
    {
      "input": "group_adults",
      "apiParam": "group_adults",
      "location": "query",
      "required": false,
      "title": "Group Adults",
      "schema": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30,
        "nullable": true,
        "description": "Number of adults (1-30). Defaults to Booking.com default."
      },
      "editor": "number"
    },
    {
      "input": "group_children",
      "apiParam": "group_children",
      "location": "query",
      "required": false,
      "title": "Group Children",
      "schema": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20,
        "nullable": true,
        "description": "Number of children (0-20)."
      },
      "editor": "number"
    },
    {
      "input": "no_rooms",
      "apiParam": "no_rooms",
      "location": "query",
      "required": false,
      "title": "No Rooms",
      "schema": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30,
        "nullable": true,
        "description": "Number of rooms (1-30)."
      },
      "editor": "number"
    },
    {
      "input": "dest_id",
      "apiParam": "dest_id",
      "location": "query",
      "required": false,
      "title": "Dest Id",
      "schema": {
        "type": "integer",
        "nullable": true,
        "description": "Booking.com destination id when known (e.g. -1456928 for Paris). Helps Booking render resolved city result pages."
      },
      "editor": "number"
    },
    {
      "input": "dest_type",
      "apiParam": "dest_type",
      "location": "query",
      "required": false,
      "title": "Dest Type",
      "schema": {
        "type": "string",
        "enum": [
          "city",
          "region",
          "district",
          "hotel",
          "landmark",
          "airport"
        ],
        "nullable": true,
        "description": "Booking.com destination type when known: city, region, district, hotel, landmark, or airport. Accepted values: city, region, district, hotel, landmark, airport."
      },
      "editor": "select"
    },
    {
      "input": "lang",
      "apiParam": "lang",
      "location": "query",
      "required": false,
      "title": "Lang",
      "schema": {
        "type": "string",
        "maxLength": 10,
        "nullable": true,
        "description": "UI language hint (e.g. en-us, de)."
      },
      "editor": "textfield"
    },
    {
      "input": "currency",
      "apiParam": "currency",
      "location": "query",
      "required": false,
      "title": "Currency",
      "schema": {
        "type": "string",
        "minLength": 3,
        "maxLength": 3,
        "nullable": true,
        "description": "3-letter currency code (e.g. EUR, USD)."
      },
      "editor": "textfield"
    }
  ],
  "resultPointer": "/data/prices",
  "fallbackResultPointers": [],
  "enrichment": {
    "field": "input_ss"
  },
  "maxResults": {
    "input": "maxResults",
    "default": 100,
    "hardLimit": 1000
  },
  "priceUsdPerResult": 0.0003,
  "timeoutSecs": 300,
  "relativeDateDefaults": [
    {
      "input": "checkin",
      "base": "today",
      "offsetDays": 30,
      "description": "When omitted, check-in is set to 30 days from today."
    },
    {
      "input": "checkout",
      "base": "checkin",
      "offsetDays": 2,
      "description": "When omitted, check-out is set to two days after check-in."
    }
  ],
  "prefill": {
