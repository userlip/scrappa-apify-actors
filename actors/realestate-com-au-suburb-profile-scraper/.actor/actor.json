{
  "actorSpecification": 1,
  "minMemoryMbytes": 128,
  "maxMemoryMbytes": 128,
  "name": "realestate-com-au-suburb-profile-scraper",
  "title": "Realestate.com.au Suburb Profile Scraper",
  "description": "Get a realestate.com.au suburb profile with median prices, market trends, rental yields, local areas, and source data. Batch profile URLs to compare Australian housing markets.",
  "categories": [
    "REAL_ESTATE"
  ],
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": {
    "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY"
  },
  "defaultMemoryMbytes": 128,
  "defaultRunOptions": {
    "timeoutSecs": 300
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "results": {
          "title": "Results",
          "transformation": {
            "fields": [
              "profile_url",
              "data"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "profile_url": {
                "label": "Profile Url",
                "format": "link"
              },
              "data": {
                "label": "Data",
                "format": "text"
              }
            }
          }
        }
      }
    }
  }
}
