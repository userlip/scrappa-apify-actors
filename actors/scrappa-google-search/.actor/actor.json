{
  "actorSpecification": 1,
  "name": "scrappa-google-search",
  "title": "Google Search SERP Scraper for SEO Research",
  "description": "Collect search result titles, links, and snippets from Google Search. Results can include `position`, `title`, `link`. Save and export Apify datasets, schedule runs, or call the Actor through the API.",
  "version": "1.0",
  "buildTag": "latest",
  "resources": {
    "memoryMbytes": 128
  },
  "input": "./input_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": {
    "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY"
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "organic": {
          "title": "Organic Results",
          "transformation": {
            "fields": ["position", "title", "link", "displayed_link", "snippet", "source"]
          },
          "display": {
            "component": "table",
            "properties": {
              "position": { "label": "#", "format": "number" },
              "title": { "label": "Title", "format": "text" },
              "link": { "label": "URL", "format": "link" },
              "displayed_link": { "label": "Display URL", "format": "text" },
              "snippet": { "label": "Snippet", "format": "text" },
              "source": { "label": "Source", "format": "text" }
            }
          }
        }
      }
    }
  }
}
