{
  "actorSpecification": 1,
  "minMemoryMbytes": 128,
  "maxMemoryMbytes": 128,
  "name": "google-search-scraper",
  "title": "Google Search Scraper",
  "description": "Find Google Search results with page titles, displayed domains, snippets and links. Use the phrase, location and locale options to shape a Google results page for your query.",
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": {
    "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY"
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "organic": {
          "title": "Organic Results",
          "transformation": {
            "fields": ["position", "title", "link", "displayed_link", "snippet", "source"]
          },
          "display": {
            "component": "table",
            "properties": {
              "position": { "label": "#", "format": "number" },
              "title": { "label": "Title", "format": "text" },
              "link": { "label": "URL", "format": "link" },
              "displayed_link": { "label": "Display URL", "format": "text" },
              "snippet": { "label": "Snippet", "format": "text" },
              "source": { "label": "Source", "format": "text" }
            }
          }
        }
      }
    }
  }
}
