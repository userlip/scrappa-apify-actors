{
  "title": "Youtube API Channel Podcasts",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "id": {
      "title": "Legacy Youtube Channel ID",
      "type": "string",
      "description": "Single Youtube Channel ID. Use ids for batch runs.",
      "editor": "textfield",
      "prefill": "UCSHZKyawb77ixDdsGog4iWA"
    },
    "ids": {
      "title": "Youtube Channel IDs",
      "type": "string",
      "description": "Comma-separated Youtube channel IDs. Prefer this for batch runs.",
      "editor": "textfield",
      "pattern": "^\\s*[^,\\s]+(?:\\s*,\\s*[^,\\s]+)*\\s*$",
      "prefill": "UCSHZKyawb77ixDdsGog4iWA"
    },
    "continuation": {
      "title": "continuation",
      "type": "string",
      "description": "Pagination token for next page",
      "editor": "textfield"
    },
    "sort": {
      "title": "Sort",
      "type": "string",
      "description": "Sort by (newest, popular, oldest)",
      "editor": "select",
      "enum": [
        "newest",
        "popular",
        "oldest"
      ],
      "prefill": "newest"
    }
  },
  "required": []
}
