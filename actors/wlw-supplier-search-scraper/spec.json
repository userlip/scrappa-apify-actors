{
  "slug": "wlw-supplier-search-scraper",
  "title": "WLW Supplier Search Scraper",
  "description": "Search WLW for suppliers with company profiles, product descriptions, categories, selling points, and order details. Batch queries and filter by country or supplier attributes.",
  "categories": [
    "LEAD_GENERATION",
    "ECOMMERCE"
  ],
  "endpoint": "/wlw/search",
  "openapiPath": "/wlw/search",
  "mode": "list",
  "batch": {
    "field": "queries",
    "valueField": "q",
    "apiParam": "q",
    "pathParam": null,
    "title": "Supplier queries",
    "description": "Product or service keywords to search on WLW (Wer liefert was).",
    "valueDescription": "keyword used for this WLW supplier search."
  },
  "parameters": [
    {
      "input": "q",
      "apiParam": "q",
      "location": "query",
      "required": true,
      "title": "Search text",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "description": "Search query (e.g., \"agentur\", \"software\", \"logistik\")"
      }
    },
    {
      "input": "page",
      "apiParam": "page",
      "location": "query",
      "required": false,
      "title": "Page",
      "schema": {
        "type": "integer",
        "minimum": 1,
        "description": "Page number (default: 1)"
      }
    },
    {
      "input": "per_page",
      "apiParam": "per_page",
      "location": "query",
      "required": false,
      "title": "Results per page",
      "schema": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "description": "Results per page (1-50, default: 15)"
      }
    },
    {
      "input": "country",
      "apiParam": "country",
      "location": "query",
      "required": false,
      "title": "Country",
      "schema": {
        "type": "string",
        "enum": [
          "DE",
          "AT",
          "CH"
        ],
        "description": "Country code: DE (Germany), AT (Austria), CH (Switzerland). Default: DE"
      },
      "editor": "select"
    },
    {
      "input": "countries",
      "apiParam": "countries",
      "location": "query",
      "required": false,
      "title": "Countries",
      "schema": {
        "type": "string",
        "pattern": "^[A-Za-z]{2}(,[A-Za-z]{2})*$",
        "description": "Filter by country codes (comma-separated, e.g., \"DE,AT\")"
      }
    },
    {
      "input": "category",
      "apiParam": "category",
      "location": "query",
      "required": false,
      "title": "Category",
      "schema": {
        "type": "string",
        "pattern": "^\\d+$",
        "description": "Filter by category ID"
      }
    },
    {
      "input": "supplier_type",
      "apiParam": "supplier_type",
      "location": "query",
      "required": false,
      "title": "Supplier Type",
      "schema": {
        "type": "string",
        "maxLength": 100,
        "description": "Filter by supplier type (comma-separated)"
      }
    },
    {
      "input": "attributes",
      "apiParam": "attributes",
      "location": "query",
      "required": false,
      "title": "Attributes",
      "schema": {
        "type": "string",
        "maxLength": 500,
        "description": "Filter by attribute codes (comma-separated)"
      }
    },
    {
      "input": "verified",
      "apiParam": "verified",
      "location": "query",
      "required": false,
      "title": "Verified",
      "schema": {
        "type": "boolean",
        "description": "Only show verified suppliers"
      }
    },
    {
      "input": "top_responder",
      "apiParam": "top_responder",
      "location": "query",
      "required": false,
      "title": "Top Responder",
      "schema": {
        "type": "boolean",
        "description": "Only show top responders"
      }
    },
    {
      "input": "latitude",
      "apiParam": "latitude",
      "location": "query",
      "required": false,
      "title": "Latitude",
      "schema": {
        "type": "number",
        "minimum": -90,
        "maximum": 90,
        "description": "Location filter: latitude"
      }
    },
    {
      "input": "longitude",
      "apiParam": "longitude",
      "location": "query",
      "required": false,
      "title": "Longitude",
      "schema": {
        "type": "number",
        "minimum": -180,
        "maximum": 180,
        "description": "Location filter: longitude"
      }
    },
    {
      "input": "radius",
      "apiParam": "radius",
      "location": "query",
      "required": false,
      "title": "Radius",
      "schema": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500,
        "description": "Search radius in km (requires lat/lng)"
      }
    },
    {
      "input": "sort",
      "apiParam": "sort",
      "location": "query",
      "required": false,
      "title": "Sort order",
      "schema": {
        "type": "string",
        "enum": [
          "relevance",
          "recency",
          "trending",
          "distance"
        ],
        "description": "Sort: relevance, recency, trending, distance"
      },
      "editor": "select"
    },
    {
      "input": "language",
      "apiParam": "language",
      "location": "query",
      "required": false,
      "title": "Language",
      "schema": {
        "type": "string",
        "minLength": 2,
        "maxLength": 2,
        "description": "Language code (default: de)"
      }
    }
  ],
  "maxResults": {
    "input": "maxResults",
    "default": 100,
    "hardLimit": 1000
  },
  "priceUsdPerResult": 0.0003,
  "timeoutSecs": 300,
  "prefill": {
    "queries": [
      {
        "q": "schrauben"
      }
    ],
    "page": 1,
    "per_page": 5,
    "country": "DE",
    "language": "de",
    "maxResults": 5,
    "maxPages": 1
  },
  "testParams": {
    "q": "schrauben"
  },
