{
  "title": "WLW Supplier Search Scraper",
  "description": "Search WLW for suppliers with company profiles, product descriptions, categories, selling points, and order details. Batch queries and filter by country or supplier attributes.",
  "type": "object",
  "schemaVersion": 1,
  "required": [
    "queries"
  ],
  "properties": {
    "queries": {
      "title": "Supplier queries",
      "type": "array",
      "description": "Product or service keywords to search on WLW (Wer liefert was).",
      "editor": "json",
      "minItems": 1,
      "maxItems": 100,
      "prefill": [
        {
          "q": "schrauben"
        }
      ],
      "items": {
        "type": "object",
        "required": [
          "q"
        ],
        "properties": {
          "q": {
            "title": "Search text",
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Search query (e.g., \"agentur\", \"software\", \"logistik\")",
            "editor": "textfield"
          },
          "page": {
            "title": "Page",
            "type": "integer",
            "minimum": 1,
            "description": "Page number (default: 1)",
            "editor": "number"
          },
          "per_page": {
            "title": "Results per page",
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "Results per page (1-50, default: 15)",
            "editor": "number"
          },
          "country": {
            "title": "Country",
            "type": "string",
            "enum": [
              "DE",
              "AT",
              "CH"
            ],
            "description": "Country code: DE (Germany), AT (Austria), CH (Switzerland). Default: DE",
            "editor": "select"
          },
          "countries": {
            "title": "Countries",
            "type": "string",
            "pattern": "^[A-Za-z]{2}(,[A-Za-z]{2})*$",
            "description": "Filter by country codes (comma-separated, e.g., \"DE,AT\")",
            "editor": "textfield"
          },
          "category": {
            "title": "Category",
            "type": "string",
            "pattern": "^\\d+$",
            "description": "Filter by category ID",
            "editor": "textfield"
          },
          "supplier_type": {
            "title": "Supplier Type",
            "type": "string",
            "maxLength": 100,
            "description": "Filter by supplier type (comma-separated)",
            "editor": "textfield"
          },
          "attributes": {
            "title": "Attributes",
            "type": "string",
            "maxLength": 500,
            "description": "Filter by attribute codes (comma-separated)",
            "editor": "textfield"
          },
          "verified": {
            "title": "Verified",
            "type": "boolean",
            "description": "Only show verified suppliers",
            "editor": "checkbox"
          },
          "top_responder": {
            "title": "Top Responder",
            "type": "boolean",
            "description": "Only show top responders",
            "editor": "checkbox"
          },
          "latitude": {
            "title": "Latitude",
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "Location filter: latitude",
            "editor": "number"
          },
          "longitude": {
            "title": "Longitude",
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "description": "Location filter: longitude",
            "editor": "number"
          },
          "radius": {
            "title": "Radius",
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Search radius in km (requires lat/lng)",
            "editor": "number"
          },
          "sort": {
            "title": "Sort order",
            "type": "string",
            "enum": [
              "relevance",
              "recency",
              "trending",
              "distance"
            ],
            "description": "Sort: relevance, recency, trending, distance",
            "editor": "select"
          },
          "language": {
            "title": "Language",
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "description": "Language code (default: de)",
            "editor": "textfield"
          }
        }
      }
    },
    "page": {
      "title": "Page",
      "type": "integer",
      "minimum": 1,
      "description": "Page number (default: 1)",
      "editor": "number",
      "prefill": 1
    },
    "per_page": {
      "title": "Results per page",
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "description": "Results per page (1-50, default: 15)",
      "editor": "number",
      "prefill": 5
    },
    "country": {
      "title": "Country",
      "type": "string",
      "enum": [
        "DE",
        "AT",
        "CH"
      ],
      "description": "Country code: DE (Germany), AT (Austria), CH (Switzerland). Default: DE",
      "editor": "select",
      "prefill": "DE"
    },
    "countries": {
      "title": "Countries",
      "type": "string",
      "pattern": "^[A-Za-z]{2}(,[A-Za-z]{2})*$",
      "description": "Filter by country codes (comma-separated, e.g., \"DE,AT\")",
      "editor": "textfield"
    },
    "category": {
      "title": "Category",
      "type": "string",
      "pattern": "^\\d+$",
      "description": "Filter by category ID",
      "editor": "textfield"
    },
    "supplier_type": {
      "title": "Supplier Type",
      "type": "string",
      "maxLength": 100,
      "description": "Filter by supplier type (comma-separated)",
      "editor": "textfield"
    },
    "attributes": {
      "title": "Attributes",
      "type": "string",
      "maxLength": 500,
      "description": "Filter by attribute codes (comma-separated)",
      "editor": "textfield"
    },
    "verified": {
      "title": "Verified",
      "type": "boolean",
      "description": "Only show verified suppliers",
      "editor": "checkbox"
    },
    "top_responder": {
      "title": "Top Responder",
      "type": "boolean",
      "description": "Only show top responders",
      "editor": "checkbox"
    },
    "latitude": {
      "title": "Latitude",
      "type": "number",
      "minimum": -90,
      "maximum": 90,
      "description": "Location filter: latitude",
      "editor": "number"
    },
    "longitude": {
      "title": "Longitude",
      "type": "number",
      "minimum": -180,
      "maximum": 180,
      "description": "Location filter: longitude",
      "editor": "number"
    },
    "radius": {
      "title": "Radius",
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "description": "Search radius in km (requires lat/lng)",
      "editor": "number"
    },
    "sort": {
      "title": "Sort order",
      "type": "string",
      "enum": [
        "relevance",
        "recency",
        "trending",
        "distance"
      ],
      "description": "Sort: relevance, recency, trending, distance",
      "editor": "select"
    },
    "language": {
      "title": "Language",
      "type": "string",
      "minLength": 2,
      "maxLength": 2,
      "description": "Language code (default: de)",
      "editor": "textfield",
      "prefill": "de"
    },
    "maxResults": {
      "title": "Maximum Results",
      "type": "integer",
      "description": "Maximum dataset items to save across this entire run.",
      "editor": "number",
      "minimum": 1,
      "maximum": 1000,
      "default": 100,
      "prefill": 5
    },
    "maxPages": {
      "title": "Maximum Pages",
      "type": "integer",
      "description": "Maximum pages to request for each batch entry.",
      "editor": "number",
      "minimum": 1,
      "maximum": 10,
      "default": 2,
      "prefill": 1
    }
  }
}
