        "nullable": true,
        "description": "Language code for the response (e.g. en-us, de)."
      },
      "editor": "textfield"
    },
    {
      "input": "currency",
      "apiParam": "currency",
      "location": "query",
      "required": false,
      "title": "Currency",
      "schema": {
        "type": "string",
        "minLength": 3,
        "maxLength": 3,
        "nullable": true,
        "description": "Three-letter currency code (e.g. EUR, USD)."
      },
      "editor": "textfield"
    }
  ],
  "resultPointer": null,
  "fallbackResultPointers": [],
