{
  "actorSpecification": 1,
  "minMemoryMbytes": 128,
  "maxMemoryMbytes": 128,
  "name": "instagram-user-reels-scraper",
  "title": "Instagram User Reels Scraper",
  "description": "Collect public Instagram Reels with captions, views, likes, comments, posting times, and links. Add several account usernames and follow cursor pages.",
  "categories": [
    "SOCIAL_MEDIA"
  ],
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": {
    "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY"
  },
  "defaultMemoryMbytes": 128,
  "defaultRunOptions": {
    "timeoutSecs": 300
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "results": {
          "title": "Results",
          "transformation": {
            "fields": [
              "shortcode",
              "author_username",
              "caption",
              "play_count",
              "like_count"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "shortcode": {
                "label": "Shortcode",
                "format": "text"
              },
              "author_username": {
                "label": "Author Username",
                "format": "text"
              },
              "caption": {
                "label": "Caption",
                "format": "text"
              },
              "play_count": {
                "label": "Play Count",
                "format": "number"
              },
              "like_count": {
                "label": "Like Count",
                "format": "number"
              }
            }
          }
        }
      }
    }
  }
}
