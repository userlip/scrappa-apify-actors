{
  "actorSpecification": 1,
  "name": "google-hotels-autocomplete-scraper",
  "title": "Google Hotels Autocomplete Scraper",
  "description": "Discover Google Hotels destinations and accommodations with normalized suggestions, property tokens, thumbnails, and ready-to-use hotel-search links.",
  "version": "1.0",
  "buildTag": "latest",
  "meta": { "templateId": "ts-start" },
  "input": "./input_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": { "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY" },
  "resources": { "memoryMbytes": 128 },
  "defaultRunOptions": { "timeoutSecs": 180 },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "suggestions": {
          "title": "Hotel Suggestions",
          "transformation": {
            "fields": ["position", "value", "autocomplete_suggestion", "type", "property_token", "thumbnail", "scrappa_google_hotels_link", "source_query", "request_gl", "request_hl", "request_currency", "request_type", "response_time_ms"]
          },
          "display": {
            "component": "table",
            "properties": {
              "position": { "label": "#", "format": "number" },
              "value": { "label": "Suggestion", "format": "text" },
              "autocomplete_suggestion": { "label": "Normalized Suggestion", "format": "text" },
              "type": { "label": "Type", "format": "text" },
              "property_token": { "label": "Property Token", "format": "text" },
              "thumbnail": { "label": "Thumbnail", "format": "image" },
              "scrappa_google_hotels_link": { "label": "Hotel Search", "format": "link" },
              "source_query": { "label": "Source Query", "format": "text" },
              "request_gl": { "label": "Country", "format": "text" },
              "request_hl": { "label": "Language", "format": "text" },
              "request_currency": { "label": "Currency", "format": "text" },
              "request_type": { "label": "Requested Type", "format": "text" },
              "response_time_ms": { "label": "Response Time", "format": "number" }
            }
          }
        }
      }
    }
  }
}
