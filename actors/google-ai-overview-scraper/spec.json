{
  "slug": "google-ai-overview-scraper",
  "title": "Google AI Overview Scraper",
  "description": "Google AI Overview Scraper collects structured data from Scrappa's /search-ai-overview endpoint. Submit multiple inputs in one Actor run and receive one dataset item per result.",
