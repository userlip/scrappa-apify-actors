    "field": "queries",
    "valueField": "query",
    "apiParam": "query",
    "pathParam": null,
    "title": "Queries",
    "description": "Batch input entries. Each query is sent as the query value."
  },
  "parameters": [
    {
      "input": "query",
      "apiParam": "query",
      "location": "query",
      "required": true,
      "title": "Query",
      "schema": {
        "type": "string",
        "description": "Search query sent to Google AI Mode.",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    {
      "input": "hl",
      "apiParam": "hl",
      "location": "query",
      "required": false,
      "title": "HL",
      "schema": {
        "type": "string",
        "description": "Interface language code (2 letters, e.g. en, de).",
        "minLength": 2,
        "maxLength": 2
      }
    },
    {
      "input": "gl",
      "apiParam": "gl",
      "location": "query",
      "required": false,
      "title": "GL",
      "schema": {
        "type": "string",
        "description": "Country code (2 letters, e.g. us, de).",
        "minLength": 2,
        "maxLength": 2
      }
    },
    {
      "input": "google_domain",
      "apiParam": "google_domain",
      "location": "query",
      "required": false,
      "title": "Google Domain",
      "schema": {
        "type": "string",
        "description": "Google domain (e.g. google.de).",
        "maxLength": 100,
        "pattern": "^google\\.(?:[a-z]{2}|com|com\\.[a-z]{2}|co\\.[a-z]{2})$"
      }
    },
    {
      "input": "uule",
      "apiParam": "uule",
      "location": "query",
      "required": false,
      "title": "Uule",
      "schema": {
        "type": "string",
        "description": "Encoded location, passed through when provided.",
        "maxLength": 500
      }
    }
