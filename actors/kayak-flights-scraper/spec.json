  },
  "tableFields": [
    {
      "name": "resultId",
      "label": "Result Id",
      "format": "text"
    },
    {
      "name": "type",
      "label": "Type",
      "format": "text"
    },
    {
      "name": "shareableUrl",
      "label": "Shareable Url",
      "format": "link"
    },
    {
      "name": "legs",
      "label": "Legs",
      "format": "text"
    },
    {
      "name": "totalProviders",
      "label": "Totalproviders",
      "format": "number"
    }
  ],
  "seo": {
    "h1": "Kayak Flights Scraper",
    "intro": "Search Kayak one-way or round-trip flights and collect flight options, airlines, providers, and routes.",
    "keywords": [
