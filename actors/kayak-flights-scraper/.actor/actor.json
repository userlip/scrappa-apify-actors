{
  "actorSpecification": 1,
  "name": "kayak-flights-scraper",
  "title": "Kayak Flights Scraper",
  "description": "Kayak Flights Scraper collects structured data from Scrappa's /kayak/flights/one-way endpoint. Submit multiple inputs in one Actor run and receive one dataset item per result.",
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": {
    "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY"
  },
  "defaultMemoryMbytes": 128,
  "defaultRunOptions": {
    "timeoutSecs": 300
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "results": {
          "title": "Results",
          "transformation": {
            "fields": [
              "resultId",
              "type",
              "shareableUrl",
              "legs",
              "totalProviders"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "resultId": {
                "label": "Result Id",
                "format": "text"
              },
              "type": {
                "label": "Type",
                "format": "text"
              },
              "shareableUrl": {
                "label": "Shareable Url",
                "format": "link"
              },
              "legs": {
                "label": "Legs",
                "format": "text"
              },
              "totalProviders": {
                "label": "Totalproviders",
                "format": "number"
              }
            }
          }
        }
      }
    }
  }
}
