{
  "actorSpecification": 1,
  "minMemoryMbytes": 128,
  "maxMemoryMbytes": 128,
  "name": "apple-app-store-search-scraper",
  "title": "Apple App Store Search Scraper",
  "description": "Search the Apple App Store for app names, publishers, prices, ratings, categories, and links. Submit several search phrases in one run to build catalogs or compare storefront listings.",
  "categories": [
    "ECOMMERCE"
  ],
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": {
    "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY"
  },
  "defaultMemoryMbytes": 128,
  "defaultRunOptions": {
    "timeoutSecs": 300
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "results": {
          "title": "Results",
          "transformation": {
            "fields": [
              "title",
              "artist",
              "rating",
              "rating_count",
              "url"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "title": {
                "label": "Title",
                "format": "text"
              },
              "artist": {
                "label": "Artist",
                "format": "text"
              },
              "rating": {
                "label": "Rating",
                "format": "number"
              },
              "rating_count": {
                "label": "Rating Count",
                "format": "number"
              },
              "url": {
                "label": "URL",
                "format": "link"
              }
            }
          }
        }
      }
    }
  }
}
