      "label": "Rating Count",
      "format": "number"
    },
    {
      "name": "url",
      "label": "Url",
      "format": "link"
    }
  ],
  "seo": {
    "h1": "Apple App Store Search Scraper",
    "intro": "Search Apple App Store listings by keyword and return app metadata, ratings, pricing, and links.",
    "keywords": [
