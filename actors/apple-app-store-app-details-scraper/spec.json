{
  "slug": "apple-app-store-app-details-scraper",
  "title": "Apple App Store App Details Scraper",
  "description": "Apple App Store App Details Scraper collects structured data from Scrappa's /apple/app-store/details endpoint. Submit multiple inputs in one Actor run and receive one dataset item per result.",
  "endpoint": "/apple/app-store/details",
  "openapiPath": "/apple/app-store/details",
  "mode": "single",
  "batch": {
    "field": "product_ids",
    "valueField": "product_id",
    "apiParam": "product_id",
    "pathParam": null,
    "title": "Product Ids",
    "description": "Batch input entries. Each product_id is sent as the product_id value."
  },
  "parameters": [
    {
      "input": "id",
      "apiParam": "id",
      "location": "query",
      "required": false,
      "title": "ID",
      "schema": {
        "type": "string",
        "description": "Scrappa id parameter.",
        "maxLength": 255,
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    },
    {
      "input": "product_id",
      "apiParam": "product_id",
      "location": "query",
      "required": true,
      "title": "Product ID",
      "schema": {
        "type": "string",
        "description": "Apple product id (numeric adam id; UMC ids also accepted for movies/TV)",
        "maxLength": 255,
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    },
    {
      "input": "store",
      "apiParam": "store",
      "location": "query",
      "required": false,
      "title": "Store",
      "schema": {
        "type": "string",
        "description": "Store vertical: apps, mac, books, audiobooks, movies, tv, music, or podcasts",
        "enum": [
          "apps",
          "mac",
          "books",
          "audiobooks",
          "movies",
          "tv",
          "music",
          "podcasts"
        ],
        "default": "apps"
      },
      "editor": "select"
    },
    {
      "input": "country",
      "apiParam": "country",
      "location": "query",
      "required": false,
      "title": "Country",
      "schema": {
        "type": "string",
        "description": "Two-letter Apple storefront country code (default: us)",
        "minLength": 2,
        "maxLength": 2,
        "default": "us"
      }
    },
    {
      "input": "season_id",
      "apiParam": "season_id",
      "location": "query",
      "required": false,
      "title": "Season ID",
      "schema": {
        "type": "string",
        "description": "TV season id; returns the season product instead of the show",
        "maxLength": 255,
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    },
    {
      "input": "num",
      "apiParam": "num",
      "location": "query",
      "required": false,
      "title": "NUM",
      "schema": {
        "type": "integer",
        "description": "Requested review result count per page",
        "minimum": 1,
        "maximum": 50
      }
    },
    {
      "input": "offset",
      "apiParam": "offset",
      "location": "query",
      "required": false,
      "title": "Offset",
      "schema": {
        "type": "integer",
        "description": "Scrappa offset parameter.",
        "minimum": 0
      }
    },
    {
      "input": "next_page_token",
      "apiParam": "next_page_token",
      "location": "query",
      "required": false,
      "title": "Next Page Token",
      "schema": {
        "type": "string",
        "description": "Review pagination token from a previous response",
        "maxLength": 100
      }
    }
  ],
