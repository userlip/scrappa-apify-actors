{
  "actorSpecification": 1,
  "name": "apple-app-store-app-details-scraper",
  "title": "Apple App Store App Details Scraper",
  "description": "Apple App Store App Details Scraper collects structured data from Scrappa's /apple/app-store/details endpoint. Submit multiple inputs in one Actor run and receive one dataset item per result.",
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": {
    "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY"
  },
  "defaultMemoryMbytes": 128,
  "defaultRunOptions": {
    "timeoutSecs": 300
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "results": {
          "title": "Results",
          "transformation": {
            "fields": [
              "title",
              "artist",
              "rating",
              "rating_count",
              "privacy"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "title": {
                "label": "Title",
                "format": "text"
              },
              "artist": {
                "label": "Artist",
                "format": "text"
              },
              "rating": {
                "label": "Rating",
                "format": "number"
              },
              "rating_count": {
                "label": "Rating Count",
                "format": "number"
              },
              "privacy": {
                "label": "Privacy",
                "format": "text"
              }
            }
          }
        }
      }
    }
  }
}
