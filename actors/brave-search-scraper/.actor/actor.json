{
  "actorSpecification": 1,
  "minMemoryMbytes": 128,
  "maxMemoryMbytes": 128,
  "name": "brave-search-scraper",
  "title": "Brave Search Scraper",
  "description": "Search Brave for ranked web results with titles, snippets, source domains, and links. Submit multiple queries in one run to compare independent search results or track page visibility.",
  "categories": [
    "SEO_TOOLS"
  ],
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": {
    "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY"
  },
  "defaultMemoryMbytes": 128,
  "defaultRunOptions": {
    "timeoutSecs": 300
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "results": {
          "title": "Results",
          "transformation": {
            "fields": [
              "title",
              "link",
              "snippet",
              "displayed_link",
              "position"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "title": {
                "label": "Title",
                "format": "text"
              },
              "link": {
                "label": "Link",
                "format": "link"
              },
              "snippet": {
                "label": "Snippet",
                "format": "text"
              },
              "displayed_link": {
                "label": "Displayed Link",
                "format": "text"
              },
              "position": {
                "label": "Position",
                "format": "number"
              }
            }
          }
        }
      }
    }
  }
}
