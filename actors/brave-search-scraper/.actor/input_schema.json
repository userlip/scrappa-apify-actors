{
  "title": "Brave Search Scraper",
  "description": "Brave Search Scraper collects structured data from Scrappa's /brave/search endpoint. Submit multiple inputs in one Actor run and receive one dataset item per result. Submit multiple batch entries in one run.",
  "type": "object",
  "schemaVersion": 1,
  "required": [
    "queries"
  ],
  "properties": {
    "queries": {
      "title": "Queries",
      "type": "array",
      "description": "Batch input entries. Each query is sent as the query value.",
      "editor": "json",
      "minItems": 1,
      "maxItems": 100,
      "prefill": [
        {
          "query": "best crm software"
        }
      ],
      "items": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "title": "Query",
            "type": "string",
            "description": "Search query (max 500 characters).",
            "maxLength": 500,
            "editor": "textfield"
          },
          "language": {
            "title": "Language",
            "type": "string",
            "description": "Language filter. Accepts english/deutsch/... or ISO codes such as en, de. Default: all.",
            "enum": [
              "english",
              "deutsch",
              "french",
              "spanish",
              "italian",
              "portuguese",
              "dutch",
              "russian",
              "chinese",
              "japanese",
              "arabic",
              "all",
              "en",
              "de",
              "fr",
              "es",
              "it",
              "pt",
              "nl",
              "ru",
              "zh",
              "ja",
              "ar"
            ],
            "default": "all",
            "editor": "select"
          },
          "page": {
            "title": "Page",
            "type": "integer",
            "description": "Result page number (1-10). Default: 1.",
            "minimum": 1,
            "maximum": 10,
            "default": 1,
            "editor": "number"
          },
          "include_html": {
            "title": "Include Html",
            "type": "boolean",
            "description": "Set to true to include the raw Brave HTML in the response. Default: false.",
            "editor": "checkbox"
          },
          "q": {
            "title": "Q",
            "type": "string",
            "description": "Alias for query. Prefer query for new integrations.",
            "editor": "textfield"
          }
        }
      }
    },
    "language": {
      "title": "Language",
      "type": "string",
      "description": "Language filter. Accepts english/deutsch/... or ISO codes such as en, de. Default: all.",
      "enum": [
        "english",
        "deutsch",
        "french",
        "spanish",
        "italian",
        "portuguese",
        "dutch",
        "russian",
        "chinese",
        "japanese",
        "arabic",
        "all",
        "en",
        "de",
        "fr",
        "es",
        "it",
        "pt",
        "nl",
        "ru",
        "zh",
        "ja",
        "ar"
      ],
      "default": "all",
      "editor": "select"
    },
    "page": {
      "title": "Page",
      "type": "integer",
      "description": "Result page number (1-10). Default: 1.",
      "minimum": 1,
      "maximum": 10,
      "default": 1,
      "editor": "number"
    },
    "include_html": {
      "title": "Include Html",
      "type": "boolean",
      "description": "Set to true to include the raw Brave HTML in the response. Default: false.",
      "editor": "checkbox"
    },
    "q": {
      "title": "Q",
      "type": "string",
      "description": "Alias for query. Prefer query for new integrations.",
      "editor": "textfield"
    },
    "maxResults": {
      "title": "Maximum Results",
      "type": "integer",
      "description": "Maximum dataset items to save across this entire run.",
      "editor": "number",
      "minimum": 1,
      "maximum": 1000,
      "default": 100
    }
  }
}
