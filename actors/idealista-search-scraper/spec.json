{
  "slug": "idealista-search-scraper",
  "title": "Idealista Property Search Scraper",
  "description": "Idealista Property Search Scraper collects structured data from Scrappa's /idealista/search endpoint. Submit multiple inputs in one Actor run and receive one dataset item per result.",
  "endpoint": "/idealista/search",
  "openapiPath": "/idealista/search",
  "mode": "list",
  "batch": {
    "field": "location_ids",
    "valueField": "location_id",
    "apiParam": "location_id",
    "pathParam": null,
    "title": "Location Ids",
    "description": "Batch input entries. Each location_id is sent as the location_id value."
  },
  "parameters": [
    {
      "input": "country",
      "apiParam": "country",
      "location": "query",
      "required": true,
      "title": "Country",
      "schema": {
        "type": "string",
        "description": "Market: es, it, pt, or fr. Default es.",
        "enum": [
          "es",
          "it",
          "pt",
          "fr"
        ]
      },
      "editor": "select"
    },
    {
      "input": "operation",
      "apiParam": "operation",
      "location": "query",
      "required": true,
      "title": "Operation",
      "schema": {
        "type": "string",
        "description": "sale or rent. Room stock uses bedrooms + rent.",
        "enum": [
          "sale",
          "rent"
        ]
      },
      "editor": "select"
    },
    {
      "input": "property_type",
      "apiParam": "property_type",
      "location": "query",
      "required": true,
      "title": "Property Type",
      "schema": {
        "type": "string",
        "description": "homes, newDevelopments, bedrooms, offices, premises, transfers, buildings, storageRooms, garages, vacationRentals, luxury, or lands.",
        "enum": [
          "homes",
          "newDevelopments",
          "bedrooms",
          "offices",
          "premises",
          "transfers",
          "buildings",
          "storageRooms",
          "garages",
          "vacationRentals",
          "luxury",
          "lands"
        ]
      },
      "editor": "select"
    },
    {
      "input": "location_id",
      "apiParam": "location_id",
      "location": "query",
      "required": true,
      "title": "Location ID",
      "schema": {
        "type": "string",
        "description": "Idealista location id such as 0-EU-ES-28.",
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    },
    {
      "input": "center",
      "apiParam": "center",
      "location": "query",
      "required": false,
      "title": "Center",
      "schema": {
        "type": "string",
        "description": "lat,lon for near-me search.",
        "maxLength": 40,
        "pattern": "^-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?$"
      }
    },
    {
      "input": "distance",
      "apiParam": "distance",
      "location": "query",
      "required": false,
      "title": "Distance",
      "schema": {
        "type": "integer",
        "description": "Radius in meters when using center.",
        "minimum": 1,
        "maximum": 50000
      }
    },
    {
      "input": "max_items",
      "apiParam": "max_items",
      "location": "query",
      "required": false,
      "title": "Max Items",
      "schema": {
        "type": "integer",
        "description": "Page size honored by origin, 1-5.",
        "minimum": 1,
        "maximum": 5,
        "default": 5
      }
    },
    {
      "input": "num_page",
      "apiParam": "num_page",
      "location": "query",
      "required": false,
      "title": "NUM Page",
      "schema": {
        "type": "integer",
        "description": "1-based page number.",
        "minimum": 1,
        "default": 1
      }
    },
    {
      "input": "order",
      "apiParam": "order",
      "location": "query",
      "required": false,
      "title": "Order",
      "schema": {
        "type": "string",
        "description": "Scrappa order parameter.",
        "maxLength": 40
      }
    },
    {
      "input": "sort",
      "apiParam": "sort",
      "location": "query",
      "required": false,
      "title": "Sort",
      "schema": {
        "type": "string",
        "description": "Scrappa sort parameter.",
        "enum": [
          "asc",
          "desc"
        ],
        "default": "desc"
      },
      "editor": "select"
    },
    {
      "input": "quality",
      "apiParam": "quality",
      "location": "query",
      "required": false,
      "title": "Quality",
      "schema": {
        "type": "string",
        "description": "Scrappa quality parameter.",
        "enum": [
          "high",
          "low"
        ]
      },
      "editor": "select"
    },
    {
      "input": "gallery",
      "apiParam": "gallery",
      "location": "query",
      "required": false,
      "title": "Gallery",
      "schema": {
        "type": "boolean",
        "description": "Scrappa gallery parameter.",
        "default": false
      }
    },
    {
      "input": "locale",
      "apiParam": "locale",
      "location": "query",
      "required": false,
      "title": "Locale",
      "schema": {
        "type": "string",
        "description": "Scrappa locale parameter.",
        "maxLength": 8
      }
    },
    {
      "input": "microsite_short_name",
      "apiParam": "microsite_short_name",
      "location": "query",
      "required": false,
      "title": "Microsite Short Name",
      "schema": {
        "type": "string",
        "description": "Anonymous agency stock filter, for example clikalia.",
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    },
    {
      "input": "chalet",
      "apiParam": "chalet",
      "location": "query",
      "required": false,
      "title": "Chalet",
      "schema": {
        "type": "boolean",
        "description": "Apply-filter key. Send true on homes."
      }
    },
    {
      "input": "current_occupation_type",
      "apiParam": "current_occupation_type",
      "location": "query",
      "required": false,
      "title": "Current Occupation Type",
      "schema": {
        "type": "string",
        "description": "free, bareOwnership, tenanted, illegallyOccupied, or viager.",
        "enum": [
          "free",
          "bareOwnership",
          "tenanted",
          "illegallyOccupied",
          "viager"
        ]
      },
      "editor": "select"
    },
    {
      "input": "auction",
      "apiParam": "auction",
      "location": "query",
      "required": false,
      "title": "Auction",
      "schema": {
        "type": "string",
        "description": "IT only: onlyAuctions or excludeAuctions.",
        "enum": [
          "onlyAuctions",
          "excludeAuctions"
        ]
      },
      "editor": "select"
    },
    {
      "input": "home_type",
      "apiParam": "home_type",
      "location": "query",
      "required": false,
      "title": "Home Type",
      "schema": {
        "type": "string",
        "description": "Scrappa home_type parameter.",
        "maxLength": 40
      }
    },
    {
      "input": "bank_offer",
      "apiParam": "bank_offer",
      "location": "query",
      "required": false,
      "title": "Bank Offer",
      "schema": {
        "type": "string",
        "description": "Scrappa bank_offer parameter.",
        "maxLength": 40
      }
    },
    {
      "input": "advertiser_type",
      "apiParam": "advertiser_type",
      "location": "query",
      "required": false,
      "title": "Advertiser Type",
      "schema": {
        "type": "string",
        "description": "Scrappa advertiser_type parameter.",
        "maxLength": 40
      }
    },
    {
      "input": "min_price",
      "apiParam": "min_price",
      "location": "query",
      "required": false,
      "title": "Min Price",
      "schema": {
        "type": "integer",
        "description": "Scrappa min_price parameter.",
        "minimum": 0
      }
    },
    {
      "input": "max_price",
      "apiParam": "max_price",
      "location": "query",
      "required": false,
      "title": "Max Price",
      "schema": {
        "type": "integer",
        "description": "Scrappa max_price parameter.",
        "minimum": 0
      }
    },
    {
      "input": "min_size",
      "apiParam": "min_size",
      "location": "query",
      "required": false,
      "title": "Min Size",
      "schema": {
        "type": "integer",
        "description": "Scrappa min_size parameter.",
        "minimum": 0
      }
    },
    {
      "input": "max_size",
      "apiParam": "max_size",
      "location": "query",
      "required": false,
      "title": "Max Size",
      "schema": {
        "type": "integer",
        "description": "Scrappa max_size parameter.",
        "minimum": 0
      }
    },
    {
      "input": "min_rooms",
      "apiParam": "min_rooms",
      "location": "query",
      "required": false,
      "title": "Min Rooms",
      "schema": {
        "type": "integer",
        "description": "Scrappa min_rooms parameter.",
        "minimum": 0
      }
    },
    {
      "input": "max_rooms",
      "apiParam": "max_rooms",
      "location": "query",
      "required": false,
      "title": "Max Rooms",
      "schema": {
        "type": "integer",
        "description": "Scrappa max_rooms parameter.",
        "minimum": 0
      }
    },
    {
      "input": "shape",
      "apiParam": "shape",
      "location": "query",
      "required": false,
      "title": "Shape",
      "schema": {
        "type": "string",
        "description": "Scrappa shape parameter."
      }
    }
  ],
  "resultPointer": "/data/elementList",
  "fallbackResultPointers": [],
  "pagination": {
    "kind": "page",
    "param": "num_page",
    "start": 1,
    "step": 1,
    "currentPagePointer": "/data/actualPage",
    "totalPagesPointer": "/data/totalPages",
    "maxPages": 10
  },
  "enrichment": {
    "field": "input_location_id"
  },
  "maxResults": {
    "input": "maxResults",
    "default": 100,
    "hardLimit": 1000
  },
  "defaultMaxPages": 2,
  "priceUsdPerResult": 0.0003,
  "timeoutSecs": 300,
