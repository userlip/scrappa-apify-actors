{
  "actorSpecification": 1,
  "name": "tiktok-user-search-scraper",
  "title": "TikTok User Search Scraper",
  "description": "Search public TikTok profiles by keyword and collect handles, display names, follower counts, and verification status. Batch topics to find creators in a niche or map public profiles.",
  "categories": [
    "SOCIAL_MEDIA",
    "MARKETING"
  ],
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": {
    "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY"
  },
  "defaultMemoryMbytes": 128,
  "defaultRunOptions": {
    "timeoutSecs": 300
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "results": {
          "title": "Results",
          "transformation": {
            "fields": [
              "user_id",
              "unique_id",
              "nickname",
              "follower_count",
              "verified"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "user_id": {
                "label": "User ID",
                "format": "text"
              },
              "unique_id": {
                "label": "Unique ID",
                "format": "text"
              },
              "nickname": {
                "label": "Nickname",
                "format": "text"
              },
              "follower_count": {
                "label": "Follower Count",
                "format": "number"
              },
              "verified": {
                "label": "Verified",
                "format": "text"
              }
            }
          }
        }
      }
    }
  }
}
