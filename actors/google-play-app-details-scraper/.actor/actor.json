{
  "actorSpecification": 1,
  "minMemoryMbytes": 128,
  "maxMemoryMbytes": 128,
  "name": "google-play-app-details-scraper",
  "title": "Google Play App Details Scraper",
  "description": "Get Google Play app details with developer, rating, review totals, downloads, category, permissions, and media links. Batch package names by country.",
  "categories": [
    "ECOMMERCE",
    "MARKETING"
  ],
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": {
    "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY"
  },
  "defaultMemoryMbytes": 128,
  "defaultRunOptions": {
    "timeoutSecs": 300
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "results": {
          "title": "Results",
          "transformation": {
            "fields": [
              "app",
              "product_info",
              "ratings",
              "updated_on"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "app": {
                "label": "App",
                "format": "text"
              },
              "product_info": {
                "label": "Product details",
                "format": "text"
              },
              "ratings": {
                "label": "Rating breakdown",
                "format": "text"
              },
              "updated_on": {
                "label": "Updated on",
                "format": "date"
              }
            }
          }
        }
      }
    }
  }
}
