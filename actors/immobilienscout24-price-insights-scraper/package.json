{
  "name": "immobilienscout24-price-insights-scraper",
  "version": "1.0.0",
  "description": "Thin Apify wrapper for Scrappa ImmobilienScout24 property-market price insights.",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:integration": "npm run build && node integration/prefilled-input.mjs",
    "test:dev": "TEST_SOURCE=src tsx --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "apify": "^3.2.6" },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
