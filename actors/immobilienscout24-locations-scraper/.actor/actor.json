{
  "actorSpecification": 1,
  "name": "immobilienscout24-locations-scraper",
  "title": "ImmobilienScout24 Locations Scraper",
  "description": "Find ImmobilienScout24 city and district suggestions with the location codes used in property searches. Enter a city or district to get matching ImmobilienScout24 location suggestions.",
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": {
    "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY"
  },
  "resources": {
    "memoryMbytes": 128
  },
  "defaultRunOptions": {
    "timeoutSecs": 300
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "locations": {
          "title": "Location matches",
          "transformation": {
            "fields": ["geocode", "name", "type", "source_query", "is_cached"]
          },
          "display": {
            "component": "table",
            "properties": {
              "geocode": { "label": "Geocode", "format": "text" },
              "name": { "label": "Location", "format": "text" },
              "type": { "label": "Type", "format": "text" },
              "source_query": { "label": "Source query", "format": "text" },
              "is_cached": { "label": "Cached fallback", "format": "boolean" }
            }
          }
        }
      }
    }
  }
}
