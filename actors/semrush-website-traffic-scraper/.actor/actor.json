{
  "actorSpecification": 1,
  "name": "semrush-website-traffic-scraper",
  "title": "Semrush Website Traffic Scraper",
  "description": "Get Semrush-style domain estimates for visits, rankings, engagement, devices, and countries. Batch websites in one run to compare traffic profiles.",
  "categories": [
    "SEO_TOOLS",
    "MARKETING"
  ],
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": {
    "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY"
  },
  "defaultMemoryMbytes": 128,
  "defaultRunOptions": {
    "timeoutSecs": 300
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "results": {
          "title": "Results",
          "transformation": {
            "fields": [
              "domain",
              "visits",
              "authority_score",
              "engagement",
              "country"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "domain": {
                "label": "Domain",
                "format": "text"
              },
              "visits": {
                "label": "Estimated Visits",
                "format": "number"
              },
              "authority_score": {
                "label": "Authority Score",
                "format": "number"
              },
              "engagement": {
                "label": "Engagement",
                "format": "text"
              },
              "country": {
                "label": "Country",
                "format": "text"
              }
            }
          }
        }
      }
    }
  }
}
