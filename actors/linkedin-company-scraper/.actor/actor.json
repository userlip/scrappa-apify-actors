{
  "actorSpecification": 1,
  "name": "linkedin-company-scraper",
  "title": "LinkedIn Company Scraper for Lead Research",
  "description": "Collect company profiles and firmographic details from LinkedIn. Results can include `name`, `industry`, `size`. Batch inputs can process multiple targets in one run. Save and export Apify datasets, schedule runs, or call the Actor through the API.",
  "version": "1.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "rust-start"
  },
  "input": "./input_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": {
    "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY"
  },
  "resources": {
    "memoryMbytes": 128
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "company": {
          "title": "Company Information",
          "transformation": {
            "fields": ["name", "industry", "size", "website", "followers", "employee_count", "type"]
          },
          "display": {
            "component": "table",
            "properties": {
              "name": { "label": "Company Name", "format": "text" },
              "industry": { "label": "Industry", "format": "text" },
              "size": { "label": "Size", "format": "text" },
              "website": { "label": "Website", "format": "link" },
              "followers": { "label": "Followers", "format": "number" },
              "employee_count": { "label": "Employees", "format": "number" },
              "type": { "label": "Type", "format": "text" }
            }
          }
        }
      }
    }
  }
}
