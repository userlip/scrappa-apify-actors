{
  "actorSpecification": 1,
  "minMemoryMbytes": 128,
  "maxMemoryMbytes": 128,
  "name": "google-maps-advanced-search-scraper",
  "title": "Google Maps Advanced Search Scraper",
  "description": "Find local businesses on Google Maps with names, categories, star ratings and addresses. Set the map center and a business category to find places in a chosen local area.",
  "version": "1.0",
  "buildTag": "latest",
  "icon": "🎯",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "./Dockerfile",
  "environmentVariables": { "SCRAPPA_API_KEY": "@SCRAPPA_API_KEY" },
  "resources": {
    "memoryMbytes": 128
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Search Results",
          "transformation": { "fields": ["name", "rating", "review_count", "full_address", "phone_numbers", "website", "latitude", "longitude"] },
          "display": {
            "component": "table",
            "properties": {
              "name": { "label": "Name", "format": "text" },
              "rating": { "label": "Rating", "format": "number" },
              "review_count": { "label": "Reviews", "format": "number" },
              "full_address": { "label": "Address", "format": "text" },
              "phone_numbers": { "label": "Phone numbers", "format": "array" },
              "website": { "label": "Website", "format": "link" },
              "latitude": { "label": "Lat", "format": "number" },
              "longitude": { "label": "Lon", "format": "number" }
            }
          }
        }
      }
    }
  }
}
