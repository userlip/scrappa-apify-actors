{
  "slug": "realestate-com-au-search-scraper",
  "title": "Realestate.com.au Property Search Scraper",
  "description": "Search realestate.com.au by suburb for buy, rent, or sold listings with prices, addresses, property features, agencies, inspections, and links. Batch locations to compare Australian markets.",
  "categories": [
    "REAL_ESTATE"
  ],
  "endpoint": "/realestate-com-au/search",
  "openapiPath": "/realestate-com-au/search",
  "mode": "list",
  "batch": {
    "field": "locations",
    "valueField": "location",
    "apiParam": "location",
    "pathParam": null,
    "title": "Australian locations",
    "description": "Suburbs or locality text to search on realestate.com.au.",
    "valueDescription": "location submitted for this property search."
  },
  "parameters": [
    {
      "input": "location",
      "apiParam": "location",
      "location": "query",
      "required": true,
      "title": "Location",
      "schema": {
        "type": "string",
        "minLength": 2,
        "maxLength": 120,
        "description": "Location search text such as Sydney, NSW."
      }
    },
    {
      "input": "channel",
      "apiParam": "channel",
      "location": "query",
      "required": false,
      "title": "Channel",
      "schema": {
        "type": "string",
        "enum": [
          "buy",
          "rent",
          "sold"
        ],
        "description": "Listing channel: buy, rent, or sold."
      },
      "editor": "select"
    },
    {
      "input": "page",
      "apiParam": "page",
      "location": "query",
      "required": false,
      "title": "Page",
      "schema": {
        "type": "integer",
        "minimum": 1,
        "description": "Page number."
      }
    },
    {
      "input": "sort",
      "apiParam": "sort",
      "location": "query",
      "required": false,
      "title": "Sort order",
      "schema": {
        "type": "string",
        "maxLength": 40,
        "description": "realestate.com.au sort type, such as new-desc or sold-date-desc."
      }
    },
    {
      "input": "min_price",
      "apiParam": "min_price",
      "location": "query",
      "required": false,
      "title": "Min Price",
      "schema": {
        "type": "integer",
        "minimum": 0,
        "description": "Minimum price filter."
      }
    },
    {
      "input": "max_price",
      "apiParam": "max_price",
      "location": "query",
      "required": false,
      "title": "Max Price",
      "schema": {
        "type": "integer",
        "minimum": 0,
        "description": "Maximum price filter."
      }
    },
    {
      "input": "min_bedrooms",
      "apiParam": "min_bedrooms",
      "location": "query",
      "required": false,
      "title": "Min Bedrooms",
      "schema": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20,
        "description": "Minimum bedroom count."
      }
    },
    {
      "input": "max_bedrooms",
      "apiParam": "max_bedrooms",
      "location": "query",
      "required": false,
      "title": "Max Bedrooms",
      "schema": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20,
        "description": "Maximum bedroom count."
      }
    },
    {
      "input": "min_bathrooms",
      "apiParam": "min_bathrooms",
      "location": "query",
      "required": false,
      "title": "Min Bathrooms",
      "schema": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20,
        "description": "Minimum bathroom count."
      }
    },
    {
      "input": "min_carspaces",
      "apiParam": "min_carspaces",
      "location": "query",
      "required": false,
      "title": "Min Carspaces",
      "schema": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20,
        "description": "Minimum parking spaces."
      }
    },
    {
      "input": "property_types",
      "apiParam": "property_types",
      "location": "query",
      "required": false,
      "title": "Property Types",
      "schema": {
        "type": "string",
        "maxLength": 200,
        "description": "Comma-separated realestate.com.au property type filters."
      }
    },
    {
      "input": "keywords",
      "apiParam": "keywords",
      "location": "query",
      "required": false,
      "title": "Keywords",
      "schema": {
        "type": "string",
        "maxLength": 200,
        "description": "Comma-separated keyword filters."
      }
    }
  ],
