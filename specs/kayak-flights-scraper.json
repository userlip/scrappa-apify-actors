  },
  "tableFields": [
    {
      "name": "resultId",
      "label": "Result ID",
      "format": "text"
    },
    {
      "name": "type",
      "label": "Type",
      "format": "text"
    },
    {
      "name": "shareableUrl",
      "label": "Shareable URL",
      "format": "link"
    },
    {
      "name": "legs",
      "label": "Legs",
      "format": "text"
    },
    {
      "name": "totalProviders",
      "label": "Total Providers",
      "format": "number"
    }
  ],
  "relativeDateDefaults": [
    {
      "input": "departure_date",
      "base": "today",
      "offsetDays": 30,
      "description": "When omitted, departure is set to 30 days from today."
    },
    {
      "input": "return_date",
      "base": "departure_date",
      "offsetDays": 4,
      "description": "When omitted for a round trip, return is set to 4 days after departure.",
      "endpoints": [
        "/round-trip"
      ]
    }
  ],
  "dedupePointer": "/resultId",
  "categories": [
    "TRAVEL"
  ],
  "storeCopy": {
    "seoTitle": "Kayak Flights Scraper | Fare Search",
    "seoDescription": "Compare Kayak flight itineraries by route and travel dates, including legs, providers, and booking links. Build datasets for planning and airfare research.",
    "intro": "Search Kayak for airport routes and collect itinerary IDs, flight legs, timing, provider counts, and shareable result links. Choose one-way or round-trip searches.",
    "useCases": [
      "Travel planners can compare itineraries across multiple airport routes.",
      "Travel agencies can check providers, flight times, and booking choices.",
      "Fare analysts can track options for one-way and round-trip searches."
    ],
    "howToUse": [
      "Add one route object with origin and destination to `flights` per search.",
      "Choose one-way or round-trip; omitted dates are set relative to today.",
      "Set passenger and cabin options, then cap pages and results."
    ],
    "faqs": [
      {
        "question": "How are travel dates chosen when omitted?",
        "answer": "Departure defaults to 30 days from the run date. A round-trip return defaults to four days later; dates can be overridden per route or at the top level."
      }
    ],
    "relatedActors": [
