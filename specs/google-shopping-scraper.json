{
  "slug": "google-shopping-scraper",
  "title": "Google Shopping Scraper",
  "description": "Google Shopping Scraper collects structured data from Scrappa's /google/shopping endpoint. Submit multiple inputs in one Actor run and receive one dataset item per result.",
  "endpoint": "/google/shopping",
  "openapiPath": "/google/shopping",
  "mode": "list",
  "batch": {
    "field": "queries",
    "valueField": "q",
    "apiParam": "q",
    "pathParam": null,
    "title": "Queries",
    "description": "Batch input entries. Each q is sent as the q value."
  },
  "parameters": [
    {
      "input": "q",
      "apiParam": "q",
      "location": "query",
      "required": true,
      "title": "Q",
      "schema": {
        "type": "string",
        "description": "Product search query.",
        "maxLength": 500
      }
    },
    {
      "input": "gl",
      "apiParam": "gl",
      "location": "query",
      "required": false,
      "title": "GL",
      "schema": {
        "type": "string",
        "description": "Two-letter country code. Default: us.",
        "minLength": 2,
        "maxLength": 2,
        "default": "us"
      }
    },
    {
      "input": "hl",
      "apiParam": "hl",
      "location": "query",
      "required": false,
      "title": "HL",
      "schema": {
        "type": "string",
        "description": "Two-letter interface language. Default: en.",
        "minLength": 2,
        "maxLength": 2,
        "default": "en"
      }
    },
    {
      "input": "location",
      "apiParam": "location",
      "location": "query",
      "required": false,
      "title": "Location",
      "schema": {
        "type": "string",
        "description": "Location name encoded as a best-effort canonical UULE. Cannot be used with uule; provide uule directly for exact targeting.",
        "maxLength": 63
      }
    },
    {
      "input": "uule",
      "apiParam": "uule",
      "location": "query",
      "required": false,
      "title": "Uule",
      "schema": {
        "type": "string",
        "description": "Encoded Google location. Cannot be used with location.",
        "maxLength": 500
      }
    },
    {
      "input": "start",
      "apiParam": "start",
      "location": "query",
      "required": false,
      "title": "Start",
      "schema": {
        "type": "integer",
        "description": "Zero-based pagination offset. Default: 0.",
        "minimum": 0,
        "maximum": 990,
        "default": 0
      }
    },
    {
      "input": "device",
      "apiParam": "device",
      "location": "query",
      "required": false,
      "title": "Device",
      "schema": {
        "type": "string",
        "description": "desktop, mobile, or tablet. Default: desktop.",
        "enum": [
          "desktop",
          "mobile",
          "tablet"
        ],
        "default": "desktop"
      },
      "editor": "select"
    },
    {
      "input": "small_business",
      "apiParam": "small_business",
      "location": "query",
      "required": false,
      "title": "Small Business",
      "schema": {
        "type": "boolean",
        "description": "Only return small-business results. Cannot be used with shoprs."
      }
    },
    {
      "input": "shoprs",
      "apiParam": "shoprs",
      "location": "query",
      "required": false,
      "title": "Shoprs",
      "schema": {
        "type": "string",
        "description": "Opaque Google Shopping filter token. Cannot be used with small_business.",
        "maxLength": 2000
      }
    }
  ],
  "resultPointer": "/shopping_results",
  "fallbackResultPointers": [],
  "pagination": {
    "kind": "page",
    "param": "start",
    "start": 0,
    "step": 20,
    "nextPointer": "/pagination/next_start",
    "maxPages": 5
  },
  "enrichment": {
    "field": "input_q"
  },
  "maxResults": {
    "input": "maxResults",
    "default": 100,
    "hardLimit": 1000
  },
  "defaultMaxPages": 2,
  "priceUsdPerResult": 0.0003,
  "timeoutSecs": 300,
  "prefill": {
    "queries": [
      {
        "q": "running shoes"
      }
    ],
    "maxResults": 20,
    "maxPages": 2
  },
  "testParams": {
    "q": "running shoes"
  },
  "fixture": {
    "search_parameters": {
      "q": "example headphones",
      "gl": "us",
      "hl": "en",
      "start": 0,
      "device": "desktop"
    },
    "shopping_results": [
      {
        "position": 1,
        "category": "Electronics",
        "title": "Example Wireless Headphones",
        "source": "Example Store",
        "thumbnail": "https://example.com/product.jpg",
        "price": "$49.00",
        "rating": 4.6,
        "reviews": 120
      }
    ],
    "pagination": {
      "current_page": 1,
      "start": 0,
      "next_start": 50
    }
  },
  "tableFields": [
    {
      "name": "title",
      "label": "Title",
      "format": "text"
    },
    {
      "name": "source",
      "label": "Source",
      "format": "text"
    },
    {
      "name": "price",
      "label": "Price",
      "format": "number"
    },
    {
      "name": "rating",
      "label": "Rating",
      "format": "number"
    },
    {
      "name": "reviews",
      "label": "Reviews",
      "format": "number"
    }
  ],
  "seo": {
    "h1": "Google Shopping Scraper",
    "intro": "Find product listings from Google Shopping with seller, price, rating, and product details.",
    "keywords": [
      "Google Shopping Scraper",
      "title",
      "source",
      "price",
      "/google/shopping API"
    ],
    "useCases": [
      "Product price monitoring",
      "Catalog research",
      "Retail competitor analysis"
    ],
    "fieldDescriptions": [
      {
        "name": "title",
        "description": "Result title or listing name."
      },
      {
        "name": "source",
        "description": "Publisher, seller, or source name."
      },
      {
        "name": "price",
        "description": "Listed product or property price."
      },
      {
        "name": "rating",
        "description": "Average product or app rating."
      },
      {
        "name": "reviews",
        "description": "Review count when provided."
      }
    ],
    "relatedActors": [
      {
        "slug": "apple-app-store-search-scraper",
        "title": "Apple App Store Search Scraper"
      },
      {
        "slug": "google-search-scraper",
        "title": "Google Search Scraper"
      }
    ]
  }
}
