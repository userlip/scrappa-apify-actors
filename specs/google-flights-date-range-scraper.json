{
  "slug": "google-flights-date-range-scraper",
  "title": "Google Flights Cheapest Dates Scraper",
  "description": "Find Google Flights’ cheapest date-range option for airport routes with price, airline, stops, duration, and itinerary legs. Batch routes and choose a future search window.",
  "endpoint": "/flights/v2/date-range",
  "openapiPath": "/flights/v2/date-range",
  "mode": "list",
  "batch": {
    "field": "routes",
    "valueField": "origin",
    "apiParam": "origin",
    "pathParam": null,
    "title": "Airport routes",
    "description": "Origin and destination airport codes to compare for the same date range.",
    "itemRequired": [
      "destination"
    ],
    "enrichBatchItem": true,
    "valueDescription": "Origin used to run this search."
  },
  "parameters": [
    {
      "input": "origin",
      "apiParam": "origin",
      "location": "query",
      "required": true,
      "title": "Origin",
      "schema": {
        "type": "string",
        "minLength": 3,
        "maxLength": 3,
        "pattern": "^[a-zA-Z]{3}$",
        "description": "Origin airport code for the route or destination search."
      },
      "editor": "textfield"
    },
    {
      "input": "destination",
      "apiParam": "destination",
      "location": "query",
      "required": true,
      "title": "Destination",
      "schema": {
        "type": "string",
        "minLength": 3,
        "maxLength": 3,
        "pattern": "^[a-zA-Z]{3}$",
        "description": "KAYAK destination code for the vacation-package search."
      },
      "editor": "textfield"
    },
    {
      "input": "adults",
      "apiParam": "adults",
      "location": "query",
      "required": false,
      "title": "Adults",
      "schema": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9,
        "nullable": true,
        "description": "Number of adult travelers included in the search."
      },
      "editor": "number"
    },
    {
      "input": "children",
      "apiParam": "children",
      "location": "query",
      "required": false,
      "title": "Children",
      "schema": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9,
        "nullable": true,
        "description": "Number of children traveling on the cruise search."
      },
      "editor": "number"
    },
    {
      "input": "infants_in_seat",
      "apiParam": "infants_in_seat",
      "location": "query",
      "required": false,
      "title": "Infants In Seat",
      "schema": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9,
        "nullable": true,
        "description": "Number of infants in seat (0-9, default: 0)"
      },
      "editor": "number"
    },
    {
      "input": "infants_on_lap",
      "apiParam": "infants_on_lap",
      "location": "query",
      "required": false,
      "title": "Infants On Lap",
      "schema": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9,
        "nullable": true,
        "description": "Number of infants on lap (0-9, default: 0)"
      },
      "editor": "number"
    },
    {
      "input": "cabin_class",
      "apiParam": "cabin_class",
      "location": "query",
      "required": false,
      "title": "Cabin Class",
      "schema": {
        "type": "string",
        "enum": [
          "economy",
          "premium_economy",
          "business",
          "first"
        ],
        "nullable": true,
        "description": "Cabin class: economy, premium_economy, business, or first (default: economy) Accepted values: economy, premium_economy, business, first."
      },
      "editor": "select"
    },
    {
      "input": "exclude_basic",
      "apiParam": "exclude_basic",
      "location": "query",
      "required": false,
      "title": "Exclude Basic",
      "schema": {
        "type": "boolean",
        "nullable": true,
        "description": "Exclude basic economy fares when searching in economy class (default: false)"
      },
      "editor": "checkbox"
    },
    {
      "input": "max_stops",
      "apiParam": "max_stops",
      "location": "query",
      "required": false,
      "title": "Max Stops",
      "schema": {
        "type": "string",
        "enum": [
          "any",
          "nonstop",
          "one_or_fewer",
          "two_or_fewer"
        ],
        "nullable": true,
        "description": "Maximum stops: any, nonstop, one_or_fewer, or two_or_fewer (default: any) Accepted values: any, nonstop, one_or_fewer, two_or_fewer."
      },
      "editor": "select"
    },
    {
      "input": "hl",
      "apiParam": "hl",
      "location": "query",
      "required": false,
      "title": "Hl",
      "schema": {
        "type": "string",
        "pattern": "^[a-zA-Z]{2}(-[a-zA-Z]{2})?$",
        "nullable": true,
        "description": "Language code (e.g., en, de, en-US)"
      },
      "editor": "textfield"
    },
    {
      "input": "gl",
      "apiParam": "gl",
      "location": "query",
      "required": false,
      "title": "Gl",
      "schema": {
        "type": "string",
        "pattern": "^[a-zA-Z]{2}$",
        "nullable": true,
        "description": "Country/region code (e.g., us, de, gb)"
      },
      "editor": "textfield"
    },
    {
      "input": "currency",
      "apiParam": "currency",
      "location": "query",
      "required": false,
      "title": "Currency",
      "schema": {
        "type": "string",
        "minLength": 3,
        "maxLength": 3,
        "nullable": true,
        "description": "Currency code for prices (e.g., USD, EUR, GBP)"
      },
      "editor": "textfield"
    },
    {
      "input": "outbound_times",
      "apiParam": "outbound_times",
      "location": "query",
      "required": false,
      "title": "Outbound Times",
      "schema": {
        "type": "string",
        "pattern": "^\\s*(?:[01]?\\d|2[0-3])\\s*,\\s*(?:[01]?\\d|2[0-3])\\s*(?:,\\s*(?:[01]?\\d|2[0-3])\\s*,\\s*(?:[01]?\\d|2[0-3])\\s*)?$",
        "nullable": true,
        "description": "Outbound time window as comma-separated hours, e.g. \"6,18\" for departures between 06:00 and 18:00. Two further values narrow the arrival window."
      },
      "editor": "textfield"
    },
    {
      "input": "bags",
      "apiParam": "bags",
      "location": "query",
      "required": false,
      "title": "Bags",
      "schema": {
        "type": "integer",
        "enum": [
          "0"
        ],
        "nullable": true,
        "description": "Carry-on bag count. Only 0 is currently supported. Accepted values: 0."
      },
      "editor": "select"
    },
    {
      "input": "api_version",
      "apiParam": "api_version",
      "location": "query",
      "required": false,
      "title": "Api Version",
      "schema": {
        "type": "integer",
        "enum": [
          "2"
        ],
        "description": "Value accepted by the Google Flights Cheapest Dates Scraper search. Accepted values: 2."
      },
      "editor": "select"
    },
    {
      "input": "from_date",
      "apiParam": "from_date",
      "location": "query",
      "required": false,
      "title": "From Date",
      "schema": {
        "type": "string",
        "format": "date",
        "description": "Start of date range in Y-m-d format"
      },
      "editor": "textfield"
    },
    {
      "input": "to_date",
      "apiParam": "to_date",
      "location": "query",
      "required": false,
      "title": "To Date",
      "schema": {
        "type": "string",
        "format": "date",
        "description": "End of date range in Y-m-d format"
      },
      "editor": "textfield"
    },
    {
      "input": "trip_duration",
      "apiParam": "trip_duration",
      "location": "query",
      "required": false,
      "title": "Trip Duration",
      "schema": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30,
        "nullable": true,
        "description": "Duration of trip in days (1-30, default: 7)"
      },
      "editor": "number"
    }
  ],
  "resultPointer": "/date_price_combinations",
  "fallbackResultPointers": [],
  "enrichment": {
    "field": "input_route"
  },
  "maxResults": {
    "input": "maxResults",
    "default": 100,
    "hardLimit": 1000
  },
  "priceUsdPerResult": 0.0003,
  "timeoutSecs": 300,
  "relativeDateDefaults": [
    {
      "input": "from_date",
      "base": "today",
      "offsetDays": 30,
      "description": "When omitted, the start date is set to 30 days from today."
    },
    {
      "input": "to_date",
      "base": "from_date",
      "offsetDays": 7,
      "description": "When omitted, the end date is set to seven days after the start date."
    }
  ],
  "prefill": {
    "routes": [
      {
        "origin": "JFK",
        "destination": "LAX"
      }
    ],
    "adults": 1,
    "cabin_class": "economy",
    "maxResults": 10
  },
