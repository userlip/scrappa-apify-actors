  "storeCopy": {
    "seoTitle": "Semrush Trending Websites | Traffic Leaders",
    "seoDescription": "Find Semrush trending websites by country with traffic, device shares, and growth rates. Batch markets to compare sites gaining online reach.",
    "intro": "Collect websites ranked in Semrush trending lists with estimated visits, device splits, and traffic growth. Search multiple country markets in one run and compare domains.",
    "useCases": [
      "SEO teams can identify websites gaining traffic in selected markets.",
      "Market researchers can monitor domain leaders across countries.",
      "Competitive analysts can compare estimated growth and device mix."
    ],
    "howToUse": [
      "Add one ISO country code to `countries` for each market.",
      "Optionally set `category` to narrow the industry list.",
      "Use `maxResults` to cap saved website rows across all markets."
    ],
    "faqs": [
      {
        "question": "Which countries can I search?",
        "answer": "Use a two-letter country code supported by Semrush, such as `us`, `gb`, or `de`."
      }
