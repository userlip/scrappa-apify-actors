  "storeCopy": {
    "seoTitle": "Booking.com Facilities | Hotel Amenities",
    "seoDescription": "Scrape Booking.com hotel facilities by property URL. Export amenity labels, hotel names, and canonical links for property and destination research.",
    "intro": "Collect public facilities listed on Booking.com hotel pages, including amenity labels and the canonical property URL. Add hotel URLs to compare lodging features.",
    "useCases": [
      "Travel planners can compare listed amenities before selecting a hotel.",
      "Hotel analysts can benchmark facility offerings across properties.",
      "Destination researchers can map lodging features by neighborhood or market."
    ],
    "howToUse": [
      "Add a Booking.com hotel URL to each entry in `hotels`.",
      "Set language or currency hints when useful for the property page.",
      "Review the facilities and associate them with the URL in each result."
